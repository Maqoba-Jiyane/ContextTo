# .gitignore for Monorepo with Node, Next.js, Nest, Python (ai-service), Prisma, Docker, and IDE files
# See https://github.com/github/gitignore for templates used as reference

### Node / JavaScript ###
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.pnp.js

### Next.js / Frontend ###
.next/
out/
.vercel/
.turbo/
dist/

### TypeScript / Build ###
build/
coverage/
lib/
*.tsbuildinfo

### Prisma ###
# Ignore generated Prisma engine artifacts and local runtime caches
**/.prisma/
prisma/migrations/

### Python ###
# Virtualenvs
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
pip-wheel-metadata/
*.egg-info/
.eggs/
dist/
build/

### FastAPI / Uvicorn logs ###
gunicorn.error.log
gunicorn.access.log
uvicorn*.log

### Local project uploads and runtime data ###
apps/core-api/uploads/
uploads/

### Environment files ###
# Local env files often contain secrets; allow committed examples like .env.example
.env
.env.*.local
*.env

### Docker ###
# Ignore Docker compose local overrides
docker-compose.override.yml
docker-compose.*.env

### IDEs and editors ###
.vscode/
.vscode-test/
.idea/
*.sublime-workspace
*.sublime-project

### OS generated files ###
.DS_Store
Thumbs.db
desktop.ini

### Logs and databases ###
*.log
logs/
*.sqlite3
*.db
*.sql

### Testing ###
.nyc_output/
.jest/
coverage/

### Misc ###
*.bak
*.tmp
*.swp
*.swo
__MACOSX/

### Ignore IDE/test/helpers generated by CI or local tools ###
.cache/
.serverless/
node-repl-history

